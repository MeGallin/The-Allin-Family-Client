{
  "name": "the-allin-family-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:deploy": "scripts\\build-deploy.cmd",
    "build:deploy:client": "scripts\\build-deploy.cmd -Mode Client",
    "build:deploy:api": "scripts\\build-deploy.cmd -Mode Api",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src vite.config.ts vitest.config.ts",
    "format:check": "prettier --check src vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deployment.test.ps1 && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deployment-modes.test.ps1",
    "test:api": "node --test ../api/tests/regression.test.mjs",
    "test:all": "npm run test && npm run test:api && npm run test:auth && npm run test:database-release && npm run test:widgets",
    "test:database-release": "node ../api/tests/run-database-release.mjs",
    "test:auth": "node ../api/tests/run-auth.mjs",
    "test:widgets": "vitest run src/components/family/home/HomeDinnerSummary.test.tsx src/features/widgets src/components/widgets src/services/request-timeout.test.ts src/hooks/useOnline.test.ts && node --test ../api/tests/widgets.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

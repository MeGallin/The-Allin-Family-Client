# Production SPA routes. The PHP API keeps its own routing and access controls.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Keep the browser origin consistent with the production API's APP_ORIGIN.
  RewriteCond %{HTTP_HOST} ^theallinfamily\.co\.uk$ [NC]
  RewriteRule ^ https://www.theallinfamily.co.uk%{REQUEST_URI} [R=308,L,NE]
  RewriteRule ^api(?:/|$) - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
